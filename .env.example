NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE

# Usa esta variable únicamente si tu proyecto de Supabase todavía muestra
# una clave anon en lugar de una publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Secreto exclusivo del servidor. Debe ser una clave aleatoria de 32 bytes codificada en Base64.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXUS_CREDENTIAL_ENCRYPTION_KEY=
